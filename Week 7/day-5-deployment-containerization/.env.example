# Sao chép thành .env ở máy local; không điền secret thật vào file được commit.
# Compose mẫu chỉ dùng POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD,
# SERVER_PORT và INVENTORY_SERVICE_URL.
POSTGRES_DB=orders
POSTGRES_USER=orders_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

SERVER_PORT=8081
INVENTORY_SERVICE_URL=http://inventory-service:8082
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Chỉ dùng ví dụ; production lấy secret từ secret manager/Vault/Kubernetes Secret.
DB_USERNAME=orders_app
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
